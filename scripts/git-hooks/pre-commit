#!/usr/bin/env bash
# 文章版面樣式閘（2026-09-22 立，事故驅動）
#
# 為什麼掛在 commit：check-article-css.mjs 原本只在部署前的 preflight 跑，
# 草稿階段沒人跑，裸 <table> 沒包 .tablewrap 的表格（退回瀏覽器預設樣式：沒框沒底沒對齊）
# 一路走到江江打開預覽才被看到。江江回報「表格醜」已經超多次。
# 官網 repo 有「草稿當輪 commit」鐵律，所以 commit 是每篇草稿必經、而且早於交審的那一刻。
#
# 只查這次 staged 的 articles/*/index.html 與 ai-trends/*/index.html，不查別篇。
# 緊急情況要略過：git commit --no-verify（會留下紀錄，事後要補修）。
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
# 2026-09-22 Codex 跨家審後改：
#  1. 檢查 staged 內容本身（寫到暫存夾），不讀工作樹，避免「工作樹修好但 staged 是舊版」漏擋
#  2. --diff-filter 加 R，改名進來的文章也要查
#  3. 逐行讀檔名，檔名含空白也不會被拆開
#  不用 mapfile：macOS 內建 bash 3.2 沒有這個指令（首測就踩到，擋下的原因是指令不存在而不是檢查器）。
#  暫存夾建在系統 TMPDIR，由系統定期清理，本 hook 不做刪除動作。
TMP="$(mktemp -d "${TMPDIR:-/tmp}/article-css-gate.XXXXXX")"
COUNT=0
while IFS= read -r f; do
  case "$f" in
    articles/*/index.html|ai-trends/*/index.html) ;;
    *) continue ;;
  esac
  mkdir -p "$TMP/$(dirname "$f")"
  git show ":$f" > "$TMP/$f"
  COUNT=$((COUNT+1))
done < <(git diff --cached --name-only --diff-filter=ACMR)
[ "$COUNT" -eq 0 ] && exit 0
ARGS=()
while IFS= read -r f; do ARGS+=("$TMP/$f"); done < <(cd "$TMP" && find articles ai-trends -name index.html 2>/dev/null)
if ! node scripts/check-article-css.mjs "${ARGS[@]}"; then
  echo ""
  echo "⛔ commit 被擋：上面這幾篇有版面元件吃不到樣式（最常見是表格沒包 <div class=\"tablewrap\">）。"
  echo "   修法：每張 <table> 外面包 <div class=\"tablewrap\">…</div>，CSS 模板已內建。"
  exit 1
fi
