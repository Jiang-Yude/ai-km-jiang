#!/bin/bash
# ─── 官網 repo pre-push 品質閘門（2026-07-06 立）───
# 任何人（Claude / Codex / 排程 / 江江本人）push 到 main，先過輕量檢查；不過就推不出去。
# 綁定方式：git config core.hooksPath scripts/git-hooks（publish.sh 每次自動確保）
# 只做「唯讀檢查」，不重生檔案（避免 push 途中弄髒工作樹）；完整重建在 publish.sh 的 preflight。
set -uo pipefail
REPO="$(git rev-parse --show-toplevel)"
cd "$REPO"

# ─── 秘密掃描（所有 push，含分支；2026-08-08 立）───
# Git 整合自動部署後，分支 push 會自動產生「公開可存取」的 preview 網址，
# 等同 push 即曝光，掃描必須前移到 hook 層（Codex 跨家審查要求）。
SAFE_DEPLOY_TOOL="${SAFE_DEPLOY_TOOL:-$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/江昱德 主知識庫/_agent/tools/safe-deploy/safe-deploy.sh}"
# 2026-10-21：先讀完要推的 ref（下面兩段都要用）。
# publish.sh 推的時候會帶 PUBLISH_SCANNED_TREE（它剛掃過秘密的那棵樹）與 PUBLISH_CHECKED_TREE（preflight 跑過的那棵樹）。
# 要推的每個 commit 的樹都跟它一樣，才略過對應的重複檢查；不一樣（rebase、重建改了內容）或手動 push 一律照掃照查。
REFS=()
while read -r local_ref local_sha remote_ref remote_sha; do REFS+=("$local_ref $local_sha $remote_ref $remote_sha"); done
_all_trees_are(){
  [[ -n "${1:-}" && ${#REFS[@]} -gt 0 ]] || return 1
  local r sha
  for r in "${REFS[@]}"; do
    sha=$(awk '{print $2}' <<<"$r")
    [[ "$sha" =~ ^0+$ ]] && continue   # 刪分支
    [[ "$(git rev-parse "${sha}^{tree}" 2>/dev/null)" == "$1" ]] || return 1
  done
}
if _all_trees_are "${PUBLISH_SCANNED_TREE:-}"; then
  echo "  ✅ 秘密掃描：publish.sh 剛掃過這棵樹，不重掃"
elif [[ "${SKIP_SECRET_SCAN:-0}" != "1" ]]; then
  if [[ -f "$SAFE_DEPLOY_TOOL" ]]; then
    bash "$SAFE_DEPLOY_TOOL" --scan-only "$REPO" < /dev/null \
      || { echo "⛔ 秘密掃描未過，push 已擋下（分支 push 也會產生公開 preview，不放行）。"; exit 1; }
  else
    echo "⛔ 找不到秘密掃描工具：$SAFE_DEPLOY_TOOL"
    echo "   知識庫可能還沒同步完，等 iCloud 下載完成再推。"
    echo "   （分支 push 也會產生公開 preview 網址，未掃描一律不放行）"
    exit 1
  fi
fi

PUSH_MAIN=0
for r in ${REFS[@]+"${REFS[@]}"}; do
  [[ "$(awk '{print $3}' <<<"$r")" == "refs/heads/main" ]] && PUSH_MAIN=1
done
[[ $PUSH_MAIN -eq 0 ]] && exit 0   # 推分支不擋（分支是工作區）
if _all_trees_are "${PUBLISH_CHECKED_TREE:-}"; then
  echo "🟢 pre-push：publish.sh 的 preflight 已在這棵樹跑過，不重跑"
  exit 0
fi

echo "🔒 pre-push 品質閘門（push main）…"
FAIL=0

if node scripts/verify-interlink.js 2>&1 | grep -q "結果：PASS"; then
  echo "  ✅ 文章互聯"
else
  echo "  ❌ verify-interlink FAIL（有文章缺互聯腳本）"; FAIL=1
fi

if node scripts/link-graph.js check 2>&1 | grep -q "結果：PASS"; then
  echo "  ✅ 雙向連結"
else
  echo "  ❌ link-graph 有斷連"; FAIL=1
fi

if python3 scripts/check-links.py; then
  echo "  ✅ 內部連結"
else
  echo "  ❌ 有內部斷鏈（見上）"; FAIL=1
fi

if [[ $FAIL -ne 0 ]]; then
  echo ""
  echo "⛔ push 已擋下。修完再推；正式發佈請走：bash scripts/publish.sh \"訊息\""
  exit 1
fi
echo "🟢 pre-push 通過"
exit 0
