{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/mika-chat.js": {
      "includeFiles": "{site-index.json,search-aliases.js,courses-data.js,article-keywords.js,slides-data.js}",
      "maxDuration": 30
    }
  },
  "redirects": [
    { "source": "/en", "destination": "/", "permanent": true },
    { "source": "/en/", "destination": "/", "permanent": true },
    { "source": "/en/index.html", "destination": "/", "permanent": true },
    { "source": "/en/articles/:slug/index.html", "destination": "/articles/:slug/", "permanent": true },
    { "source": "/en/articles/:slug/", "destination": "/articles/:slug/", "permanent": true },
    { "source": "/en/articles/:slug", "destination": "/articles/:slug/", "permanent": true },
    { "source": "/en/ai-trends/:slug/index.html", "destination": "/ai-trends/:slug/", "permanent": true },
    { "source": "/en/ai-trends/:slug/", "destination": "/ai-trends/:slug/", "permanent": true },
    { "source": "/en/ai-trends/:slug", "destination": "/ai-trends/:slug/", "permanent": true },
    { "source": "/en/:page(agent|ai-trends|articles|cases|courses|invited-talks|knowledge-architecture|learn|offers|resources|skills).html", "destination": "/:page.html", "permanent": true },
    { "source": "/en/:path*", "destination": "/", "permanent": true }
  ]
}
